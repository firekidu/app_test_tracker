BETTER_AUTH_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32  (back it up; if lost, reconnect Google)
ENCRYPTION_KEY=
