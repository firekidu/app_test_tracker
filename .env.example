# Used only on the very first start, when no users exist. Must be changed at first sign-in.
INITIAL_ADMIN_PASSWORD=
PASSWORD_MIN_LENGTH=15
PWNED_CHECK=false
LOCKOUT_ATTEMPTS=5
LOCKOUT_MINUTES=15
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7
SHEET_ID=16InGEU5x475zzJUBS0Emzsexneca9d3NwP3rT4lNcsY
SHEET_TAB=Sheet1
CHANGELOG_TAB=Change log
PEOPLE_TAB=People
DRIVE_ROOT_FOLDER_NAME=SMPRD Media
OPEN_STATUSES=In progress,Feature is Coming soon,TBD
STALL_DAYS=14
SYNC_SECONDS=30
MAX_UPLOAD_MB=100
AUTO_END_DATE=true
